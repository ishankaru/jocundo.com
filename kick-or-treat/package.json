{
  "name": "kick-or-treat-poll",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create kick-or-treat-poll",
    "db:init": "wrangler d1 execute kick-or-treat-poll --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute kick-or-treat-poll --local --file=./schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
